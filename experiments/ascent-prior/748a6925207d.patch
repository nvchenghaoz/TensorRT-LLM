index 000000000..d3f97582e
--- /dev/null
+++ b/experiments/ascent/marlin_smallm/pair_bench.py
@@ -0,0 +1,115 @@
+import os, sys, json
+import torch
+from tensorrt_llm._torch.modules import linear as L
+# Dense Marlin NVFP4 W4A16 decode GEMM, cold-L2 CUDA-graph pair bench (brace-free on purpose:
+# passed verbatim via python -c to the base and candidate trees).
+# Shapes (N,K,copies): GDN out_proj / attn o_proj (5120,6144) x15, GDN in_proj_qkvz (16384,5120) x6,
+# attn qkv_proj (14336,5120) x7: each graph replays C distinct copies (>= 256 MB, cold L2).
+# Two arms per tree, captured separately and replayed alternately in one process:
+#   default = this tree's selection; kill = TRTLLM_MARLIN_SMALLM_TABLE=0 (main's selection).
+# On the base tree both arms are main. Output hashes (all C outputs) let the candidate's kill arm
+# be compared bitwise with the base tree's default arm across the pair.
+SH = [(5120, 6144, 15), (16384, 5120, 6), (14336, 5120, 7)]
+MS = [1, 2, 4, 8]
+WARM, ITERS = 10, 100
+dev = torch.device("cuda")
+def log(*a):
+    print(*a, flush=True)
+def mk(n, k, seed):
+    g = torch.Generator(device=dev).manual_seed(seed)
+    w = torch.randn(n, k, generator=g, device=dev) * 0.02
+    w = w * (torch.rand(n, 1, generator=g, device=dev) * 1.5 + 0.25)
+    s = (w.abs().amax() / 448.0).float()
+    w8 = (w / s).to(torch.float8_e4m3fn)
+    del w
+    wv = w8.to(torch.bfloat16)
+    amax = wv.abs().amax().float() * s
+    gg = torch.exp2(torch.ceil(torch.log2(amax / 2688.0)))
+    fp4, sf = torch.ops.trtllm.fp4_quantize(wv, (s / gg).reshape(1), 16, False, True)
+    return L._pack_nvfp4_weight_for_marlin(fp4, sf, gg.reshape(1).to(torch.float32), n, k, 16)
+def gemm(x, c, n, k):
+    return torch.ops.trtllm.marlin_nvfp4_gemm(x, c[0], scale_a=None, scale_b=c[1], alpha=None,
+        weight_global_scale=c[2], bias=None, out_dtype=torch.bfloat16, size_n=n, size_k=k)
+def h(ts):
+    acc = 0
+    for t in ts:
+        v = t.contiguous().view(torch.int16).view(-1).to(torch.int64)
+        idx = torch.arange(v.numel(), device=v.device, dtype=torch.int64)
+        acc = (acc * 1000003 + int(((v + 40000) * (idx % 65521 + 1)).sum().item())) % (2 ** 61 - 1)
+    return str(acc)
+def setarm(arm):
+    os.environ.pop("TRTLLM_MARLIN_SMALLM_CFG", None)
+    if arm == "kill":
+        os.environ["TRTLLM_MARLIN_SMALLM_TABLE"] = "0"
+    else:
+        os.environ.pop("TRTLLM_MARLIN_SMALLM_TABLE", None)
+ARMS = ["default", "kill"]
+res = dict()
+hashes = dict()
+for n, k, C in SH:
+    copies = [mk(n, k, 1000 + i) for i in range(C)]
+    torch.cuda.synchronize()
+    nb = n * k // 2 + n * k // 16
+    log("shape", n, k, "copies", C, "MB/copy %.1f" % (nb / 1e6))
+    for m in MS:
+        g = torch.Generator(device=dev).manual_seed(7 + m)
+        x = torch.randn(m, k, generator=g, device=dev).to(torch.bfloat16)
+        graphs = dict()
+        outs = dict()
+        for arm in ARMS:
+            setarm(arm)
+            s0 = torch.cuda.Stream()
+            s0.wait_stream(torch.cuda.current_stream())
+            with torch.cuda.stream(s0):
+                for _ in range(2):
+                    o = [gemm(x, c, n, k) for c in copies]
+            torch.cuda.current_stream().wait_stream(s0)
+            torch.cuda.synchronize()
+            gr = torch.cuda.CUDAGraph()
+            with torch.cuda.graph(gr):
+                o = [gemm(x, c, n, k) for c in copies]
+            graphs[arm] = gr
+            outs[arm] = o
+        setarm("default")
+        for arm in ARMS:
+            for _ in range(WARM):
+                graphs[arm].replay()
+        torch.cuda.synchronize()
+        evs = dict((arm, []) for arm in ARMS)
+        for it in range(ITERS):
+            for arm in (ARMS if it % 2 == 0 else ARMS[::-1]):
+                e0 = torch.cuda.Event(enable_timing=True)
+                e1 = torch.cuda.Event(enable_timing=True)
+                e0.record()
+                graphs[arm].replay()
+                e1.record()
+                evs[arm].append((e0, e1))
+        torch.cuda.synchronize()
+        for arm in ARMS:
+            t = sorted(e0.elapsed_time(e1) / C for e0, e1 in evs[arm])
+            med, p10, p90 = t[len(t) // 2], t[len(t) // 10], t[(9 * len(t)) // 10]
+            key = "%d,%d" % (n, k)
+            res.setdefault(arm, dict()).setdefault(key, dict())[str(m)] = dict(
+                kernel_ms=med, p10_ms=p10, p90_ms=p90, noise_floor=(p90 - p10) / med,
+                tb_s=nb / (med * 1e-3) / 1e12)
+            hashes.setdefault(arm, dict()).setdefault(key, dict())[str(m)] = h(outs[arm])
+        d = res["default"]["%d,%d" % (n, k)][str(m)]
+        kk = res["kill"]["%d,%d" % (n, k)][str(m)]
+        same = hashes["default"]["%d,%d" % (n, k)][str(m)] == hashes["kill"]["%d,%d" % (n, k)][str(m)]
+        log("(%d,%d) M=%d default %.2f us (p10 %.2f p90 %.2f) kill %.2f us (p10 %.2f p90 %.2f) d=%+.2f us outputs_equal=%s" % (
+            n, k, m, d["kernel_ms"] * 1e3, d["p10_ms"] * 1e3, d["p90_ms"] * 1e3, kk["kernel_ms"] * 1e3,
+            kk["p10_ms"] * 1e3, kk["p90_ms"] * 1e3, (d["kernel_ms"] - kk["kernel_ms"]) * 1e3, same))
+        del graphs, outs
+    del copies
+    torch.cuda.empty_cache()
+prim = res["default"]["5120,6144"]
+batch = dict((mm, dict(kernel_ms=prim[mm]["kernel_ms"], noise_floor=prim[mm]["noise_floor"], p90_ms=prim[mm]["p90_ms"])) for mm in prim)
+w = dict((("5120,6144", 64), ("16384,5120", 48), ("14336,5120", 16)))
+step = dict()
+for arm in ARMS:
+    step[arm] = dict((mm, sum(res[arm][key][mm]["kernel_ms"] * cnt for key, cnt in w.items())) for mm in prim)
+out = dict(batch=batch, primary_shape="(5120,6144) GDN out_proj + attn o_proj, us/call median over 100 graph replays of 15 cold copies",
+           shapes=res, output_hashes=hashes, per_step_marlin_ms_weighted_64_48_16=step, warmup=WARM, iters=ITERS)
+out["output"] = dict(class_note="see check job; kill arm bitwise vs base via output_hashes")
+out["output"]["class"] = "reordered"
+print(json.dumps(out))
