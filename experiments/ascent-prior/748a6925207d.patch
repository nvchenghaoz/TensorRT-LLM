index 000000000..f546b1420
--- /dev/null
+++ b/experiments/ascent/marlin_smallm/sweep.py
@@ -0,0 +1,124 @@
+# STEP 1 sweep: dense Marlin NVFP4 small-M launch shape (thread cfg x grid x stages)
+# for (5120,6144), (16384,5120), (14336,5120) at M=1,2,4.
+# Cold L2: each config's CUDA graph runs C distinct weight copies back to back
+# (>= 256 MB). All configs of one (shape, M) are captured, then replayed
+# alternately in one process; main's selection (TRTLLM_MARLIN_SMALLM_TABLE=0,
+# no override) is the in-process reference. Outputs of copy 0 are compared
+# bitwise with main's and against an FP32 reference of the dequantized operands.
+import json
+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import torch  # noqa: E402
+
+from common import (SHAPES, err, gemm, log, make_copy, max_smem, nbytes,  # noqa: E402
+                    set_cfg, smem_ok)
+
+WARM, ITERS = 10, int(os.environ.get("SWEEP_ITERS", "80"))
+MS = [int(v) for v in os.environ.get("SWEEP_MS", "1,2,4").split(",")]
+
+CFGS = {
+    (5120, 6144): [
+        "128,64,128,188,8", "128,64,128,188,10",
+        "128,64,128,160,4", "128,64,128,160,6", "128,64,128,160,8", "128,64,128,160,10",
+        "128,64,128,80,8", "128,64,128,80,10",
+        "128,128,256,188,4", "128,128,256,188,6", "128,128,256,120,4", "128,128,256,120,6",
+        "128,128,256,160,6", "128,128,256,80,6",
+        "64,128,128,160,4", "64,128,128,160,8", "64,128,128,120,8", "64,128,128,80,8",
+        "64,128,128,188,8",
+    ],
+    (16384, 5120): [
+        "128,128,256,188,6", "128,128,256,128,4", "128,128,256,128,6",
+        "64,128,128,128,6", "64,128,128,128,8", "64,128,128,188,8", "64,128,128,188,4",
+    ],
+    (14336, 5120): [
+        "128,128,256,188,6", "128,128,256,112,4", "128,128,256,112,6",
+        "64,128,128,112,6", "64,128,128,112,8", "64,128,128,188,8", "64,128,128,188,4",
+    ],
+}
+
+only = os.environ.get("SWEEP_SHAPES")
+maxsm, sms = max_smem()
+log("device", torch.cuda.get_device_name(0), "sms", sms, "max smem optin", maxsm)
+result = dict()
+for (n, k), C in SHAPES.items():
+    if only and "%d,%d" % (n, k) not in only.split(";"):
+        continue
+    copies, refs = [], None
+    for i in range(C):
+        c, r = make_copy(n, k, 1000 + i, want_ref=(i == 0))
+        copies.append(c)
+        if r is not None:
+            refs = r
+    torch.cuda.synchronize()
+    log("shape", (n, k), "copies", C, "MB/copy %.1f" % (nbytes(n, k) / 1e6), "subnormal blocks", refs["n_sub"],
+        "mem GB %.2f" % (torch.cuda.memory_allocated() / 1e9))
+    cfgs = ["main"]
+    for cfg in CFGS[(n, k)]:
+        ok, sz = smem_ok(cfg, maxsm)
+        if not ok:
+            log("  skip (smem %d > %d)" % (sz, maxsm - 512), cfg)
+            continue
+        cfgs.append(cfg)
+    shape_res = dict()
+    for m in MS:
+        g = torch.Generator(device="cuda").manual_seed(7 + m)
+        x = (torch.randn(m, k, generator=g, device="cuda") * 1.0).to(torch.bfloat16)
+        ref = x.float() @ refs["w_ref"].t()
+        graphs, outs, eager = dict(), dict(), dict()
+        for cfg in cfgs:
+            set_cfg(cfg)
+            eager[cfg] = gemm(x, copies[0], n, k).clone()
+            s0 = torch.cuda.Stream()
+            s0.wait_stream(torch.cuda.current_stream())
+            with torch.cuda.stream(s0):
+                for _ in range(2):
+                    o = [gemm(x, c, n, k) for c in copies]
+            torch.cuda.current_stream().wait_stream(s0)
+            torch.cuda.synchronize()
+            gr = torch.cuda.CUDAGraph()
+            with torch.cuda.graph(gr):
+                o = [gemm(x, c, n, k) for c in copies]
+            graphs[cfg] = gr
+            outs[cfg] = o
+        set_cfg("main")
+        for cfg in cfgs:
+            for _ in range(WARM):
+                graphs[cfg].replay()
+        torch.cuda.synchronize()
+        evs = dict((cfg, []) for cfg in cfgs)
+        for it in range(ITERS):
+            order = cfgs if it % 2 == 0 else cfgs[::-1]
+            for cfg in order:
+                e0 = torch.cuda.Event(enable_timing=True)
+                e1 = torch.cuda.Event(enable_timing=True)
+                e0.record()
+                graphs[cfg].replay()
+                e1.record()
+                evs[cfg].append((e0, e1))
+        torch.cuda.synchronize()
+        mres = dict()
+        for cfg in cfgs:
+            t = sorted(e0.elapsed_time(e1) * 1e3 / C for e0, e1 in evs[cfg])
+            med, p10, p90 = t[len(t) // 2], t[len(t) // 10], t[(9 * len(t)) // 10]
+            o0 = outs[cfg][0]
+            e = err(o0, ref)
+            mres[cfg] = dict(us=med, p10=p10, p90=p90, tbs=nbytes(n, k) / (med * 1e-6) / 1e12,
+                             bitwise_vs_main=bool(torch.equal(o0.view(torch.int16), outs["main"][0].view(torch.int16))),
+                             replay_eq_eager=bool(torch.equal(o0.view(torch.int16), eager[cfg].view(torch.int16))),
+                             max_abs=e["max_abs"], mean_abs=e["mean_abs"], ulp=e["bf16_ulp"], finite=e["finite"])
+        base = mres["main"]["us"]
+        for cfg in sorted(cfgs, key=lambda c: mres[c]["us"]):
+            r = mres[cfg]
+            log("  (%d,%d) M=%d %-20s median %6.2f us p10 %6.2f p90 %6.2f  %.3f TB/s  d=%+6.2f us  bitwise=%s "
+                "replay==eager=%s max_abs %.4g mean_abs %.4g (ulp %.3g)" % (
+                    n, k, m, cfg, r["us"], r["p10"], r["p90"], r["tbs"], r["us"] - base, r["bitwise_vs_main"],
+                    r["replay_eq_eager"], r["max_abs"], r["mean_abs"], r["ulp"]))
+        shape_res[str(m)] = mres
+        del graphs, outs
+        torch.cuda.synchronize()
+    result["%d,%d" % (n, k)] = shape_res
+    del copies, refs
+    torch.cuda.empty_cache()
+print(json.dumps(dict(sweep=result, warmup=WARM, iters=ITERS)))
