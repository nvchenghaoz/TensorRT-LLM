new file mode 100644
index 000000000..f4605cfb7
--- /dev/null
+++ b/experiments/ascent/marlin_smallm/check.py
@@ -0,0 +1,126 @@
+# Correctness check for the dense Marlin NVFP4 small-M launch-shape table.
+#  A. Accuracy, rows 1-16 at every tabled shape: table output (default env) vs an independent
+#     FP32 reference of the dequantized NVFP4 operands; main's selection (TRTLLM_MARLIN_SMALLM_TABLE=0)
+#     on the same inputs gives the bar: max-abs and mean-abs <= main's + 1 BF16 ulp of the output
+#     magnitude (stricter than the protocol's 1.25x main + 1 ulp). Rows the table does not cover
+#     must be bitwise equal to main's selection. No NaN/Inf.
+#  B. Repeated execution, the timed loop's structure: C distinct copies in one CUDA graph,
+#     10 warmup + 50 replays; before every replay the graph's outputs are NaN-poisoned; after every
+#     replay all outputs must be bitwise equal to replay 1, and an eager call (rotating copy) made
+#     between replays must equal the first eager call of that copy and the graph output.
+#  C. Kill switch: TRTLLM_MARLIN_SMALLM_TABLE=0 is bitwise equal to the explicit main configuration
+#     (the default selection: 188 CTAs, 4 stages) forced through TRTLLM_MARLIN_SMALLM_CFG, and the
+#     cross-tree comparison with the base build is in the pair bench's output_hashes.
+#  D. Lock workspace: zeroed per call on this base (at::zeros), nothing persistent to check.
+import json
+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import torch  # noqa: E402
+
+from common import SHAPES, err, gemm, log, make_copy, set_cfg  # noqa: E402
+
+TABLE_ROWS = int(os.environ.get("CHECK_TABLE_MAX_ROWS", "8"))
+MAIN_CFG = {(5120, 6144): "128,64,128,188,4", (16384, 5120): "128,128,256,188,4",
+            (14336, 5120): "128,128,256,188,4"}
+WARM, ITERS = 10, 50
+fails = []
+summary = dict()
+
+
+def check(cond, msg):
+    log(("PASS " if cond else "FAIL ") + msg)
+    if not cond:
+        fails.append(msg)
+
+
+def eq(a, b):
+    return bool(torch.equal(a.view(torch.int16), b.view(torch.int16)))
+
+
+for (n, k), C in SHAPES.items():
+    copies, refs = [], None
+    for i in range(C):
+        c, r = make_copy(n, k, 3000 + i, want_ref=(i == 0))
+        copies.append(c)
+        if r is not None:
+            refs = r
+    key = "%d,%d" % (n, k)
+    summary[key] = dict(subnormal_blocks=refs["n_sub"], rows=dict())
+    # ---------------- A + C
+    for m in range(1, 17):
+        g = torch.Generator(device="cuda").manual_seed(100 + m)
+        x = (torch.randn(m, k, generator=g, device="cuda")).to(torch.bfloat16)
+        ref = x.float() @ refs["w_ref"].t()
+        set_cfg(None)
+        y_t = gemm(x, copies[0], n, k)
+        set_cfg("main")
+        y_m = gemm(x, copies[0], n, k)
+        set_cfg(MAIN_CFG[(n, k)])
+        y_f = gemm(x, copies[0], n, k)
+        set_cfg(None)
+        et, em = err(y_t, ref), err(y_m, ref)
+        ulp = et["bf16_ulp"]
+        same = eq(y_t, y_m)
+        summary[key]["rows"][str(m)] = dict(table_max_abs=et["max_abs"], table_mean_abs=et["mean_abs"],
+                                            main_max_abs=em["max_abs"], main_mean_abs=em["mean_abs"],
+                                            bf16_ulp=ulp, bitwise_vs_main=same)
+        log("A (%d,%d) rows=%2d table max %.5f mean %.6f | main max %.5f mean %.6f | ulp %.4f | bitwise_vs_main %s" % (
+            n, k, m, et["max_abs"], et["mean_abs"], em["max_abs"], em["mean_abs"], ulp, same))
+        check(et["finite"], "A (%d,%d) rows=%d finite" % (n, k, m))
+        check(et["max_abs"] <= em["max_abs"] + ulp and et["mean_abs"] <= em["mean_abs"] + ulp,
+              "A (%d,%d) rows=%d table error <= main's + 1 BF16 ulp" % (n, k, m))
+        if m > TABLE_ROWS:
+            check(same, "A (%d,%d) rows=%d (outside the table) bitwise == main selection" % (n, k, m))
+        check(eq(y_m, y_f), "C (%d,%d) rows=%d TABLE=0 bitwise == explicit main config %s" % (
+            n, k, m, MAIN_CFG[(n, k)]))
+    # ---------------- B
+    for m in [1, 2, 3, 4, 8, 16]:
+        set_cfg(None)
+        g = torch.Generator(device="cuda").manual_seed(200 + m)
+        x = (torch.randn(m, k, generator=g, device="cuda")).to(torch.bfloat16)
+        eager0 = [gemm(x, c, n, k).clone() for c in copies]
+        s0 = torch.cuda.Stream()
+        s0.wait_stream(torch.cuda.current_stream())
+        with torch.cuda.stream(s0):
+            for _ in range(2):
+                o = [gemm(x, c, n, k) for c in copies]
+        torch.cuda.current_stream().wait_stream(s0)
+        torch.cuda.synchronize()
+        gr = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(gr):
+            outs = [gemm(x, c, n, k) for c in copies]
+        first, ndiff, n_eager_diff, nan_seen = None, 0, 0, 0
+        for it in range(WARM + ITERS):
+            for t in outs:
+                t.fill_(float("nan"))
+            gr.replay()
+            torch.cuda.synchronize()
+            cur = [t.clone() for t in outs]
+            nan_seen += sum(int(torch.isnan(t.float()).any().item()) for t in cur)
+            if first is None:
+                first = cur
+            for a, b, e in zip(cur, first, eager0):
+                if not (eq(a, b) and eq(a, e)):
+                    ndiff += 1
+            j = it % C
+            ye = gemm(x, copies[j], n, k)
+            if not eq(ye, eager0[j]):
+                n_eager_diff += 1
+        check(ndiff == 0 and n_eager_diff == 0 and nan_seen == 0,
+              "B (%d,%d) M=%d %d NaN-poisoned replays x %d copies bitwise == replay 1 == eager; interleaved eager "
+              "bitwise stable (replay diffs %d, eager diffs %d, NaN outputs %d)" % (
+                  n, k, m, WARM + ITERS, C, ndiff, n_eager_diff, nan_seen))
+        del gr, outs
+    del copies, refs
+    torch.cuda.empty_cache()
+
+print(json.dumps(dict(passed=not fails, failures=fails, summary=summary,
+                      compared_against="independent FP32 reference from the dequantized NVFP4 operands "
+                                       "(LUT E2M1 x E4M3 SF x g, subnormal-scale blocks flushed as Marlin does); "
+                                       "main's selection (TRTLLM_MARLIN_SMALLM_TABLE=0) on the same inputs; "
+                                       "explicit main config via TRTLLM_MARLIN_SMALLM_CFG",
+                      repeated_execution="15/6/7 distinct copies per shape in one CUDA graph, %d warmup + %d "
+                                         "NaN-poisoned replays per M in 1,2,3,4,8,16, interleaved eager calls" % (
+                                             WARM, ITERS))))
