index 000000000..b46fa553b
--- /dev/null
+++ b/experiments/ascent/marlin_smallm/fork.py
@@ -0,0 +1,104 @@
+# GDN decode fork chain at (16384,5120): in_proj_qkvz on dense Marlin (main
+# stream) || in_proj_ba small-N Triton GEMV (N=96, aux stream), exactly as
+# GatedDeltaNet._compute_tokenwise_inputs runs it via maybe_execute_in_parallel
+# with multi-stream on (CUDA-graph decode). Pitfall 592: a Marlin grid/smem
+# change at this site changes whether the GEMV co-resides, so the fork must be
+# timed, not only the serial chain.
+# Per layer: elementwise predecessor (x * norm weight) -> fork -> join.
+# Cold L2: C=6 distinct qkvz copies (283 MB) + 6 in_proj_ba weights in one graph.
+# Arms (env, re-captured per arm, replayed alternately in one process):
+#   A = main selection (TRTLLM_MARLIN_SMALLM_TABLE=0), T* = small-M overrides.
+import json
+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import torch  # noqa: E402
+
+from common import gemm, log, make_copy, set_cfg  # noqa: E402
+from tensorrt_llm._torch.modules.multi_stream_utils import (  # noqa: E402
+    maybe_execute_in_parallel, with_multi_stream)
+from tensorrt_llm._torch.modules.small_n_gemv import maybe_small_n_gemv  # noqa: E402
+
+N, K, NBA, C = 16384, 5120, 96, 6
+WARM, ITERS = 10, int(os.environ.get("FORK_ITERS", "100"))
+MS = [int(v) for v in os.environ.get("FORK_MS", "1,2,3,4").split(",")]
+# Job 450 (sweep build) ran FORK_ARMS="main;table;64,128,128,128,6;128,128,256,128,4;128,128,256,188,6".
+ARMS = os.environ.get("FORK_ARMS", "main;table").split(";")
+
+copies = [make_copy(N, K, 2000 + i)[0] for i in range(C)]
+g = torch.Generator(device="cuda").manual_seed(5)
+bas = [(torch.randn(NBA, K, generator=g, device="cuda") * 0.02).to(torch.bfloat16) for _ in range(C)]
+nws = [(1.0 + 0.1 * torch.randn(K, generator=g, device="cuda")).to(torch.bfloat16) for _ in range(C)]
+aux = torch.cuda.Stream()
+ev0, ev1 = torch.cuda.Event(), torch.cuda.Event()
+log("built", C, "qkvz copies; mem GB %.2f" % (torch.cuda.memory_allocated() / 1e9))
+
+
+def layer(x, i):
+    h = x * nws[i]
+    qkvz, ba = maybe_execute_in_parallel(lambda: gemm(h, copies[i], N, K),
+                                         lambda: maybe_small_n_gemv(h, bas[i]), ev0, ev1, aux)
+    return qkvz, ba
+
+
+def chain(x, fork):
+    outs = []
+    with with_multi_stream(fork):
+        for i in range(C):
+            outs.append(layer(x, i))
+    return outs
+
+
+res = dict()
+for m in MS:
+    x = (torch.randn(m, K, generator=g, device="cuda")).to(torch.bfloat16)
+    assert maybe_small_n_gemv(x, bas[0]) is not None, "in_proj_ba not routed to small_n_gemv"
+    graphs, outs = dict(), dict()
+    keys = []
+    for arm in ARMS:
+        for fork in (True, False):
+            key = "%s|%s" % (arm, "fork" if fork else "serial")
+            set_cfg(None if arm == "table" else arm)
+            s0 = torch.cuda.Stream()
+            s0.wait_stream(torch.cuda.current_stream())
+            with torch.cuda.stream(s0):
+                for _ in range(2):
+                    chain(x, False)
+            torch.cuda.current_stream().wait_stream(s0)
+            torch.cuda.synchronize()
+            gr = torch.cuda.CUDAGraph()
+            with torch.cuda.graph(gr):
+                o = chain(x, fork)
+            graphs[key], outs[key] = gr, o
+            keys.append(key)
+    set_cfg("main")
+    for key in keys:
+        for _ in range(WARM):
+            graphs[key].replay()
+    torch.cuda.synchronize()
+    evs = dict((key, []) for key in keys)
+    for it in range(ITERS):
+        for key in (keys if it % 2 == 0 else keys[::-1]):
+            e0 = torch.cuda.Event(enable_timing=True)
+            e1 = torch.cuda.Event(enable_timing=True)
+            e0.record()
+            graphs[key].replay()
+            e1.record()
+            evs[key].append((e0, e1))
+    torch.cuda.synchronize()
+    mres = dict()
+    ref_key = "main|fork"
+    for key in keys:
+        t = sorted(e0.elapsed_time(e1) * 1e3 / C for e0, e1 in evs[key])
+        med, p10, p90 = t[len(t) // 2], t[len(t) // 10], t[(9 * len(t)) // 10]
+        same_ba = all(torch.equal(a[1], b[1]) for a, b in zip(outs[key], outs[ref_key]))
+        mres[key] = dict(us=med, p10=p10, p90=p90, ba_bitwise_vs_main=bool(same_ba))
+    for key in keys:
+        r = mres[key]
+        log("M=%d %-32s median %6.2f us/layer p10 %6.2f p90 %6.2f  d_vs_main_same_mode=%+6.2f" % (
+            m, key, r["us"], r["p10"], r["p90"],
+            r["us"] - mres["main|" + key.split("|")[1]]["us"]))
+    res[str(m)] = mres
+    del graphs, outs
+print(json.dumps(dict(fork=res, copies=C, warmup=WARM, iters=ITERS)))
